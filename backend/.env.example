# Server
PORT=3100
FRONTEND_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://flight_tracker:flight_tracker@localhost:5432/flight_tracker
DB_LOGGING=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# AeroDataBox (get a free key at rapidapi.com/aedbx-aedbx/api/aerodatabox)
AERODATABOX_KEY=

# adsb.lol contact (requested by their ToS — your email or URL)
ADSB_CONTACT=

# Optional: background airport history collection
# COLLECT_AIRPORTS=BLR,DEL
# COLLECT_INTERVAL_HOURS=12

# Social login (US-012) — a provider's button is hidden until both its values are set.
# Redirect URI to register with each provider: <OAUTH_REDIRECT_BASE_URL>/api/auth/oauth/<google|github>/callback
#   Google: console.cloud.google.com/apis/credentials (OAuth client ID, type "Web application")
#   GitHub: github.com/settings/developers (OAuth App)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:3100
OAUTH_STATE_TTL_MINS=10
