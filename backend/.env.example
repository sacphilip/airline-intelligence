# Server
PORT=3100
FRONTEND_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://flight_tracker:flight_tracker@localhost:5432/flight_tracker
DB_LOGGING=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# AeroDataBox (get a free key at rapidapi.com/aedbx-aedbx/api/aerodatabox)
AERODATABOX_KEY=

# adsb.lol contact (requested by their ToS — your email or URL)
ADSB_CONTACT=

# Optional: background airport history collection
# COLLECT_AIRPORTS=BLR,DEL
# COLLECT_INTERVAL_HOURS=12
